{
  "model_name": "gpt2-xl",
  "target_layers": [13, 14, 15, 16, 17],

  "token_init_method": "target_smart",
  "token_init_std": 0.1,
  "learnable_gates": true,

  "use_low_rank": false,
  "token_rank": 64,

  "edit_module_type": "enhanced",
  "use_multiscale": true,
  "use_context_gating": false,
  "use_temperature": true,
  "use_residual_scaling": true,

  "injector_type": "enhanced",
  "use_progressive_injection": true,
  "use_attention_injection": false,
  "use_dynamic_layers": false,

  "num_epochs": 250,
  "learning_rate": 0.005,
  "batch_size": 1,
  "optimizer": "adam",
  "scheduler": "cosine",
  "warmup_steps": 20,

  "w_edit": 10.0,
  "w_suppress": 1.0,
  "w_ortho": 0.1,
  "w_local": 2.0,
  "rewrite_loss_scale": 2.0,

  "use_curriculum": false,
  "use_hard_mining": false,
  "use_adaptive_weights": false,
  "use_contrastive_loss": false,
  "use_focal_loss": false,

  "ortho_prompt_lambda": 1.0,
  "ortho_token_lambda": 1.0,
  "ortho_method": "inner_product",

  "routing_threshold": 0.95,
  "use_embedding_routing": true,
  "use_template_routing": false,
  "routing_aggregation": "max",

  "use_forward": true,
  "use_backward": true,
  "use_judge": true,
  "use_distract": true,
  "num_paraphrase": 40,

  "device": "cuda",
  "seed": 42,
  "verbose": true,
  "save_checkpoints": true,
  "early_stop_patience": 20,
  "early_stop_min_delta": 0.0001
}
