{
  "model_name": "gpt2-xl",
  "target_layers": [20, 21, 22, 23, 24],

  "token_init_method": "target_smart",
  "token_init_std": 0.1,
  "learnable_gates": true,

  "use_low_rank": false,
  "token_rank": 64,

  "edit_module_type": "enhanced",
  "use_multiscale": true,
  "use_context_gating": false,
  "use_temperature": true,
  "use_residual_scaling": true,

  "injector_type": "enhanced",
  "use_progressive_injection": true,
  "use_attention_injection": false,
  "use_dynamic_layers": false,

  "num_epochs": 300,
  "learning_rate": 0.003,
  "batch_size": 1,
  "optimizer": "adam",
  "scheduler": "cosine",
  "warmup_steps": 20,

  "w_edit": 8.0,
  "w_suppress": 2.5,
  "w_ortho": 0.2,
  "w_local": 3.5,
  "w_contrastive": 1.0,
  "rewrite_loss_scale": 2.0,

  "use_curriculum": true,
  "curriculum_stages": [50, 150],
  "use_hard_mining": true,
  "hard_boost_factor": 2.5,
  "use_adaptive_weights": true,
  "use_contrastive_loss": true,
  "contrastive_margin": 2.5,
  "contrastive_temperature": 0.08,
  "use_focal_loss": true,
  "focal_gamma": 2.0,
  "use_label_smoothing": false,
  "label_smoothing": 0.1,

  "ortho_prompt_lambda": 1.0,
  "ortho_token_lambda": 1.0,
  "ortho_method": "inner_product",

  "routing_threshold": 0.82,
  "use_embedding_routing": true,
  "use_template_routing": false,
  "routing_aggregation": "max",

  "use_forward": true,
  "use_backward": true,
  "use_judge": true,
  "use_distract": true,
  "num_paraphrase": 20,

  "device": "cuda",
  "seed": 42,
  "verbose": true,
  "save_checkpoints": true,
  "early_stop_patience": 25,
  "early_stop_min_delta": 0.0001
}
